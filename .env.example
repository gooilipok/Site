# Application Environment Configuration
# Copy this file to .env for deployment

# App General
APP_NAME="BauSquad"
APP_ENV="production"
APP_URL="http://localhost:3000"
SECRET_KEY="bau_squad_super_secret_jwt_key_change_in_production_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
PORT=3000
HOST="0.0.0.0"

# MySQL Database Configuration
MYSQL_HOST="db"
MYSQL_PORT=3306
MYSQL_DATABASE="bausquad_db"
MYSQL_USER="bausquad_user"
MYSQL_PASSWORD="bausquad_secure_password"
MYSQL_ROOT_PASSWORD="bausquad_root_password"
DATABASE_URL="mysql+pymysql://bausquad_user:bausquad_secure_password@db:3306/bausquad_db"

# Telegram Bot API Settings
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyZ"
TELEGRAM_ADMIN_CHAT_ID="-100123456789"

# SMTP Mailer Settings
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@bausquad.ru"
SMTP_PASSWORD="your_app_password_here"
SMTP_FROM="BauSquad Support <noreply@bausquad.ru>"

# CORS Origins
ALLOWED_ORIGINS="http://localhost:3000,https://bausquad.ru"
